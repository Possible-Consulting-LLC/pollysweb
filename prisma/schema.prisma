generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  passwordHash     String?
  authVersion      String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailChangeVersion String? @db.Uuid
  /// user | admin | super_admin (database CHECK enforced).
  role             String   @default("user")
  suspendedAt      DateTime?
  deletingAt       DateTime?
  /// Rotated by a database trigger on authorization changes; null preserves rollout sessions.
  adminVersion     String?  @db.Uuid
  /// Optimistic concurrency for administrative account forms; not a session credential.
  testContextVersion String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountVersion   Int      @default(0)
  isDemo           Boolean  @default(false)
  demoPlan         String?
  demoLabel        String?
  billingCheckoutIntent BillingCheckoutIntent?
  protectedOwner   ProtectedOwner?
  dateFormat       String   @default("MMM d, yyyy")
  /// IANA timezone for displaying activity times (e.g. America/Chicago).
  timezone         String   @default("")
  measurement      String   @default("imperial")
  theme            String   @default("cosmic")
  feedDefaultDays  Int      @default(3)
  mistDefaultDays  Int      @default(1)
  cleanDefaultDays Int      @default(14)
  /// free | pro
  plan             String   @default("free")
  stripeCustomerId String?  @unique
  stripeSubscriptionId String? @unique
  stripePriceId    String?
  subscriptionStatus String?
  subscriptionCurrentPeriodEnd DateTime?
  billingLastCheckedAt DateTime?
  billingNextCheckAt DateTime?
  billingCheckFailures Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  spiders   Spider[]
  reminders Reminder[]
  careDays  CareDay[]
  careCheckins CareCheckin[]
  celebratedRewards CelebratedReward[]
  accounts  Account[]
  facebookDeletionRequests FacebookDeletionRequest[]
  subscriptions UserSubscription[]

  @@index([billingNextCheckAt, id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model CareDay {
  id          String   @id @default(cuid())
  userId      String
  dayKey      String
  timeZone    String
  invalidatedAt DateTime?
  completedAt DateTime @default(now())
  snapshot    Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId, completedAt])
}

model Spider {
  id              String   @id @default(cuid())
  userId          String
  name            String
  species         String?
  commonName      String?
  sex             String   @default("Unknown") // Female | Male | Unknown
  instar          String?
  hatchDate       DateTime?
  acquisitionDate DateTime?
  source          String?
  status          String   @default("Normal") // Normal | Possible premolt | Premolt | Molting | Post-molt recovery
  profilePhoto    String?
  notes           String?
  /// When set, this spood is memorialized (passed) and does not count toward free-plan limits.
  memorializedAt  DateTime?
  passedOn        DateTime?
  memorialNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enclosure    Enclosure?
  careCheckins CareCheckin[]
  feedings     FeedingEvent[]
  mistings     MistingEvent[]
  molts        MoltEvent[]
  observations ObservationEvent[]
  bodyConditions BodyConditionEvent[]
  photos       Photo[]
  reminders    Reminder[]

  @@index([userId])
  @@index([userId, memorializedAt])
}

model Enclosure {
  id           String   @id @default(cuid())
  spiderId     String   @unique
  name         String?
  dimensions   String?
  setupDate    DateTime?
  type         String?  // acrylic | glass | mesh | custom | other
  notes        String?
  photo        String?
  lastCleaned  DateTime?
  lastRehoused DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spider       Spider                     @relation(fields: [spiderId], references: [id], onDelete: Cascade)
  maintenance  EnclosureMaintenanceEvent[]
}

model FeedingEvent {
  id           String   @id @default(cuid())
  spiderId     String
  date         DateTime @default(now())
  preyType     String
  quantity     Int      @default(1)
  preySize     String?
  outcome      String   // Ate normally | Ate partially | Showed interest but did not eat | Ignored prey | Refused prey | Appeared stressed / afraid of prey
  notes        String?
  photoUrl     String?
  createdAt    DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, date])
}

model MistingEvent {
  id               String   @id @default(cuid())
  spiderId         String
  date             DateTime @default(now())
  mistedEnclosure  Boolean  @default(true)
  waterDroplet     Boolean  @default(false)
  methods          String   @default("[]")
  notes            String?
  createdAt        DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, date])
}

model MoltEvent {
  id                 String   @id @default(cuid())
  spiderId           String
  moltDate           DateTime
  approximate        Boolean  @default(false)
  previousInstar     String?
  newInstar          String?
  moltPhoto          String?
  postMoltPhoto      String?
  notes              String?
  successful         Boolean  @default(true)
  daysSincePriorMolt Int?
  fastingDaysBefore  Int?
  createdAt          DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, moltDate])
}

model ObservationEvent {
  id        String   @id @default(cuid())
  spiderId  String
  date      DateTime @default(now())
  kind      String   // built hammock | unusually active | etc | custom
  notes     String?
  photoUrl  String?
  createdAt DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, date])
}

model BodyConditionEvent {
  id          String   @id @default(cuid())
  spiderId    String
  date        DateTime @default(now())
  condition   String   // Very thin | Thin | Normal | Plump | Very full
  notes       String?
  createdAt   DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, date])
}

model EnclosureMaintenanceEvent {
  id          String   @id @default(cuid())
  enclosureId String
  date        DateTime @default(now())
  kind        String   // cleaning | rehouse | maintenance
  notes       String?
  createdAt   DateTime @default(now())

  enclosure Enclosure @relation(fields: [enclosureId], references: [id], onDelete: Cascade)

  @@index([enclosureId, date])
}

model Photo {
  id        String   @id @default(cuid())
  spiderId  String
  url       String
  caption   String?
  kind      String   @default("general") // profile | molt | feeding | observation | general
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([spiderId, takenAt])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  spiderId  String?
  kind      String   // feeding | misting | cleaning
  intervalDays Int
  enabled   Boolean  @default(true)
  lastSentAt DateTime?
  // Architecture note: lastSentAt / enabled support future native push delivery
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  spider Spider? @relation(fields: [spiderId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared application abuse counters. Server-only; no client-facing RLS policies.
model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// One-time, hashed email links. Registration rows exist before the User does.
model PendingEmailVerification {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  previousEmail String?
  credentialSnapshot String?
  name      String?
  userId    String?
  /// Safe historical requester reference; intentionally not a cascading relation.
  requestedByAdminId String?
  purpose   String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model CareCheckin {
  userId String
  spiderId String
  dayKey String
  deferred Json @default("{}")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spider Spider @relation(fields: [spiderId], references: [id], onDelete: Cascade)
  @@id([userId, dayKey, spiderId])
}

model CelebratedReward {
  userId String
  key String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
}

// Receipts for Facebook deletion requests. Never mark completed merely on receipt.
model FacebookDeletionRequest {
  id               String   @id @default(cuid())
  requestHash      String   @unique
  subjectHash      String
  confirmationCode String   @unique
  userId           String?
  status           String   @default("pending_review")
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectHash])
  @@index([status, createdAt])
}

// Server-only singleton. Created only by a verified infrastructure bootstrap.
model ProtectedOwner {
  id        Int      @id @default(1)
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Safe references intentionally have no User relations: history survives deletion.
model AdminAudit {
  id String @id @default(cuid())
  actorId String
  targetId String?
  action String
  reason String
  changes Json
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}
// Only the hash of a random browser proof is retained; never provider tokens.
model AdminReauth {
  tokenHash String @id
  actorId String
  credentialVersion String
  provider String?
  providerAccountId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  verifiedAt DateTime?
  @@index([expiresAt])
  @@index([actorId])
}

// No foreign key: minimal receipt survives account deletion. Internal manifest cleared at completion.
model AccountDeletionOperation {
 id String @id
 targetId String @unique
 targetRole String
 stage String @default("blocked_access")
 manifest Json
 customerId String?
 subscriptionId String?
 spiderCount Int
 eventCount Int
 photoCount Int
 subscriptionPresent Boolean
 createdAt DateTime @default(now())
 completedAt DateTime?
}

// Records admitted uploads before they can become orphaned by a concurrent deletion.
model OwnedUpload {
 key String @id
 settled Boolean @default(false)
 userId String
 createdAt DateTime @default(now())
 @@index([userId])
}

// Committed before Stripe I/O. Never discard an ambiguous operation by list absence.
model BillingCheckoutIntent {
  id         String   @id
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  interval   String
  priceId    String
  appUrl     String
  customerId String?
  phase      String   @default("prepare")
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
}

// Opaque browser token hashes only. Explicit cleanup preserves safe audit history.
model AdminTestSession {
 id String @id
 tokenHash String @unique
 actorId String
 targetId String
 credentialVersion String
 createdAt DateTime @default(now())
 expiresAt DateTime
 endedAt DateTime?
 @@index([actorId])
 @@index([targetId])
 @@index([expiresAt])
}

// Server-only durable maintenance singleton. Missing state fails closed.
model SiteSettings {
 id Int @id @default(1)
 version Int @default(0)
 deadline DateTime?
 announcementEnabled Boolean @default(false)
 announcement String @default("")
 updatedBy String?
 updatedAt DateTime @updatedAt
}

// Code-owned feature catalog, mirrored from src/lib/features/registry.ts by
// src/lib/admin/feature-sync.ts. Rows whose key leaves the registry stay as
// reviewable orphans; assignment to plans references these keys.
model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  category    String
  /// Global release state; a feature stays inactive until a super administrator releases it.
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planTranslations FeaturePlanTranslation[]
}

// Super-admin plan catalog. Identity is the id: names are display labels and
// may repeat across custom or internal plans. Billing options are edited per
// plan; one ACTIVE option per (planId, interval) is enforced at the service
// layer (src/lib/admin/plans.ts), not by a partial unique index.
model Plan {
  id          String   @id @default(cuid())
  name        String
  description String
  /// STANDARD | CUSTOM | INTERNAL (validated at the service layer).
  planType    String
  /// Maximum spoods allowed on the plan; null means unlimited.
  maxSpiders  Int?
  active      Boolean  @default(false)
  public      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billingOptions PlanBillingOption[]
  featureTranslations FeaturePlanTranslation[]
  subscriptions UserSubscription[]

  @@index([sortOrder, name])
}

// One row per plan and billing interval; at most one active row per interval.
model PlanBillingOption {
  id             String  @id @default(cuid())
  planId         String
  /// MONTHLY | ANNUAL (validated at the service layer).
  interval       String
  basePriceCents Int
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, interval])
  @@index([planId, active])
  subscriptions UserSubscription[]
}

// One assigned plan subscription per row. At most one row per user is effective
// (status TRIALING/ACTIVE/PAST_DUE and not expired); new assignments end-date
// the prior effective row. discountId is a plain nullable scalar: the Discount
// entities are a later phase that adds the relation and FK.
model UserSubscription {
  id                  String   @id @default(cuid())
  userId              String
  planId              String
  planBillingOptionId String
  discountId          String?
  /// TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED (service-validated).
  status              String
  startedAt           DateTime
  renewsAt            DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingOption PlanBillingOption @relation(fields: [planBillingOptionId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([planId, status, expiresAt])
}

// Per-plan feature assignment. The pair (planId, featureId) is unique and
// missing translations resolve as disabled. Matrix saves upsert enabled values
// and never delete rows, so a disabled feature can be restored with its row
// (and creation history) intact.
model FeaturePlanTranslation {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}
