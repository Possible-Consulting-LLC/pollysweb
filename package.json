{
  "name": "spoodly-space",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:legacy-sync": "tsx --conditions=react-server scripts/staging-legacy-subscriptions.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "tsx --test src/lib/*.test.ts src/lib/**/*.test.ts src/components/*.test.ts src/components/**/*.test.ts",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@date-fns/tz": "^1.5.0",
    "@lucide/lab": "^0.7.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "heic-to": "^1.5.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
