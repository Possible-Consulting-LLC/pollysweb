# Supabase Postgres (Transaction pooler — used by the app at runtime)
# Dashboard → Project Settings → Database → Connection string → URI (Transaction / port 6543)
DATABASE_URL="postgresql://postgres.jfutawxwjqekerugbqzt:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (Session / port 5432, or Direct)
DIRECT_URL="postgresql://postgres.jfutawxwjqekerugbqzt:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Supabase Storage (public bucket: spoods) — required for photo uploads on Vercel
NEXT_PUBLIC_SUPABASE_URL="https://jfutawxwjqekerugbqzt.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Optional: use the service role key instead for server uploads
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Feedback emails (Resend) — sends to hello@beccapossible.com by default
RESEND_API_KEY="re_xxxxxxxx"
# Optional overrides:
# FEEDBACK_TO_EMAIL="hello@beccapossible.com"
# RESEND_FROM_EMAIL="Spoodly Space <onboarding@resend.dev>"

# Auth.js — REQUIRED in production (Vercel). Missing AUTH_SECRET causes:
# {"message":"There was a problem with the server configuration."}
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://127.0.0.1:43123"
NEXTAUTH_URL="http://127.0.0.1:43123"
# Production (Vercel):
# AUTH_URL="https://spoodly-space.vercel.app"
# NEXTAUTH_URL="https://spoodly-space.vercel.app"
