# Supabase Postgres (Transaction pooler — used by the app at runtime)
# Dashboard → Project Settings → Database → Connection string → URI (Transaction / port 6543)
DATABASE_URL="postgresql://postgres.jfutawxwjqekerugbqzt:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (Session / port 5432, or Direct)
DIRECT_URL="postgresql://postgres.jfutawxwjqekerugbqzt:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Supabase Storage (private bucket: spoods) — required for photo uploads and reads
NEXT_PUBLIC_SUPABASE_URL="https://jfutawxwjqekerugbqzt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-sb-secret-key"

# Feedback emails (Resend) — sends to support@spoodlyspace.com by default
RESEND_API_KEY="re_xxxxxxxx"
# Optional overrides:
# FEEDBACK_TO_EMAIL="support@spoodlyspace.com"
# RESEND_FROM_EMAIL="Spoodly Space <onboarding@resend.dev>"

# Password account email verification (separate from feedback email)
EMAIL_RESEND_API_KEY="re_verification_key"
EMAIL_FROM_EMAIL="Spoodly Space <verify@example.com>"
# Optional public link origin; defaults to AUTH_URL. Keep OAuth callbacks on AUTH_URL.
# EMAIL_VERIFICATION_ORIGIN="https://staging.spoodlyspace.com"
# Required in staging: comma-separated mailbox addresses that may receive links.
# EMAIL_ALLOWED_RECIPIENTS="keeper@example.com"
# Set only after working delivery is confirmed, e.g. 2026-09-17T00:00:00Z.
# PASSWORD_EMAIL_VERIFICATION_GRACE_START="2026-09-17T00:00:00Z"

# Stripe billing (Spoodly Pro — $1.99/mo or $19.99/yr)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_MONTHLY="price_xxx"
STRIPE_PRICE_YEARLY="price_xxx"
# Optional publishable key if you add client-side Stripe.js later:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Auth.js — REQUIRED in production (Vercel). Missing AUTH_SECRET causes:
# {"message":"There was a problem with the server configuration."}
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://127.0.0.1:43123"
NEXTAUTH_URL="http://127.0.0.1:43123"
# Production (Vercel):
# AUTH_URL="https://spoodly-space.vercel.app"
# NEXTAUTH_URL="https://spoodly-space.vercel.app"
